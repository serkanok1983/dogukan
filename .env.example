# .env.local olarak kopyalayın (git'e girmez). Hepsi isteğe bağlıdır:
# uygulama bunlar olmadan da çalışır; `npm run deploy` eksikleri uyarı olarak yazar.

# Firebase (Realtime Database + Anonim Kimlik Doğrulama). Kurulum: docs/ROLLOUT.md
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Ebeveyn PIN'i (/bilgi). Karma = SHA-256("<pin>:<tuz>"), küçük harf onaltılık.
# Hesaplamak için (1234 ve tuz-degeri yerine kendi değerlerinizi yazın):
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]+':'+process.argv[2]).digest('hex'))" 1234 tuz-degeri
# Not: karma pakette açıktır; 4 haneli PIN + kilit bir çocuk kapısıdır, güvenlik değildir.
NEXT_PUBLIC_PARENT_PIN_HASH=
NEXT_PUBLIC_PIN_SALT=
